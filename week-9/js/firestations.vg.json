{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 1100,
  "height": 740,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "js/VIC_shape_LGA.json",
        "format": {
          "type": "topojson",
          "feature": "LGA_POLYGON"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#DCE2E8",
        "stroke": "white",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/Ambulance_Stations_vic.csv"
      },
      "mark": {
        "type": "circle",
        "color": "orange",
        "size": 30,
        "opacity": 0.85,
        "stroke": "white",
        "strokeWidth": 0.3
      },
      "encoding": {
        "longitude": {
          "field": "facility_long",
          "type": "quantitative"
        },
        "latitude": {
          "field": "facility_lat",
          "type": "quantitative"
        }
        ,
        "tooltip": [
          { "field": "facility_name", "type": "nominal", "title": "Facility" },
          { "field": "gnaf_formatted_address", "type": "nominal", "title": "Address" },
          { "field": "abs_suburb", "type": "nominal", "title": "Suburb" },
          { "field": "abs_postcode", "type": "nominal", "title": "Post Code" }]
      }
    },
    {
      "data": {
        "url": "data/Metro_Fire_vic.csv"
      },
      "mark": {
        "type": "circle",
        "color": "red",
        "size": 30,
        "opacity": 0.85,
        "stroke": "white",
        "strokeWidth": 0.3
      },
      "encoding": {
        "longitude": {
          "field": "facility_long",
          "type": "quantitative"
        },
        "latitude": {
          "field": "facility_lat",
          "type": "quantitative"
        }
        ,
        "tooltip": [
          { "field": "facility_name", "type": "nominal", "title": "Facility" },
          { "field": "gnaf_formatted_address", "type": "nominal", "title": "Address" },
          { "field": "abs_suburb", "type": "nominal", "title": "Suburb" },
          { "field": "abs_postcode", "type": "nominal", "title": "Post Code" }]
      }
    },
    {
      "data": {
        "url": "data/Police_Stations_vic.csv"
      },
      "mark": {
        "type": "circle",
        "color": "darkblue",
        "size": 30,
        "opacity": 0.85,
        "stroke": "white",
        "strokeWidth": 0.3
      },
      "encoding": {
        "longitude": {
          "field": "facility_long",
          "type": "quantitative"
        },
        "latitude": {
          "field": "facility_lat",
          "type": "quantitative"
        }
        ,
        "tooltip": [
          { "field": "facility_name", "type": "nominal", "title": "Facility" },
          { "field": "gnaf_formatted_address", "type": "nominal", "title": "Address" },
          { "field": "abs_suburb", "type": "nominal", "title": "Suburb" },
          { "field": "abs_postcode", "type": "nominal", "title": "Post Code" }]
      }
    
    },
    {
      "data": {
        "url": "data/Rural_fire_vic.csv"
      },
      "mark": {
        "type": "circle",
        "color": "red",
        "size": 30,
        "opacity": 0.85,
        "stroke": "white",
        "strokeWidth": 0.3
      },
      "encoding": {
        "longitude": {
          "field": "facility_long",
          "type": "quantitative"
        },
        "latitude": {
          "field": "facility_lat",
          "type": "quantitative"
        }
        ,
        "tooltip": [
          { "field": "facility_name", "type": "nominal", "title": "Facility" },
          { "field": "gnaf_formatted_address", "type": "nominal", "title": "Address" },
          { "field": "abs_suburb", "type": "nominal", "title": "Suburb" },
          { "field": "abs_postcode", "type": "nominal", "title": "Post Code" }]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "background": "white"
  }
}